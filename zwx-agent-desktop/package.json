{
  "name": "zwx-agent-desktop",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "npm --prefix ../zwx-agent-frontend run build:desktop",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:icon": "sh scripts/generate-icon.sh",
    "dist:mac": "npm run build:web && npm run prepare:assets && npm run prepare:icon && electron-builder --mac dmg zip --arm64",
    "start": "npm run prepare:assets && electron ."
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zwx.agent.desktop",
    "productName": "ZWX Agent",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.icns",
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    }
  }
}
